# Cold Fusion Calendar — deployment config
# Copy this file to .env and fill in your own values:
#   cp .env.example .env

# SSH user on the deployment server
DEPLOY_USER=esa

# Hostname or SSH alias (must already be reachable: `ssh $DEPLOY_USER@$DEPLOY_HOST` works)
DEPLOY_HOST=lackluster.org

# Absolute path on the server where the static site should land.
# Trailing slash matters — rsync will mirror INTO this directory.
DEPLOY_PATH=/var/www/html/cf/

# Public URL printed at the end of a successful deploy (purely informational)
DEPLOY_URL=https://www.lackluster.org/cf/
